      <div style="min-height:120px;display:flex;align-items:center;justify-content:center;border:1px dashed var(--border2);border-radius:7px;">
        <span style="font-size:13px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--text3);">Your form embed goes here</span>
      </div>
