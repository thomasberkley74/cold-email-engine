  </div>

  <!-- NUDGE ARROW -->
  <div class="arrow-nudge">
    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>

  <!-- FORM -->
  <div class="form-section" id="apply">
