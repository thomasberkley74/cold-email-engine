    <!-- ============================================================ -->
    <div class="form-footer-note">
      Founding client pricing available — <span>first 3 spots only.</span> Price increases after spots are filled.
    </div>
  </div>

  <!-- PERFORMANCE STRIP -->
  <div class="guarantee-strip">
